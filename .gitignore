**/__pycache__/
*.py[cod]
*$py.class
*.pyd
*.so

# =========================================================
# Build / packaging
# =========================================================
build/
dist/
site/
.eggs/
*.egg
*.egg-info/
pip-wheel-metadata/
nerfstudio.egg-info/
wheelhouse/

# =========================================================
# Test / tooling caches
# =========================================================
# Python caches
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
